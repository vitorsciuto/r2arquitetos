---
import A from '../../layouts/A.astro';
import Contato from '../../components/a/Contato.astro';
import { contato } from '../../data/escritorio';
import { meta } from '../../components/a/site';

const descricao = meta([contato.enderecoFormal, contato.telefone, contato.email]);
---
<A titulo="Contato" descricao={descricao}>
  <section class="wrap g secao--g" aria-labelledby="contato">
    <h1 id="contato" class="t-rotulo contato-pag__h1">Contato</h1>
    <div class="contato-pag__bloco">
      <Contato grande />
      <a class="t-rotulo link-sub" href={contato.mapa} target="_blank" rel="noopener">Google Maps</a>
    </div>
  </section>
</A>
