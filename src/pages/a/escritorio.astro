---
import A from '../../layouts/A.astro';
import { arquitetos, foco, servicos, sobre } from '../../data/escritorio';

// o parágrafo do foco abre a página na faixa; os demais vêm em duas colunas
const institucional = sobre.filter((p) => p !== foco);
---
<A titulo="Escritório" descricao={foco}>
  <section class="faixa" aria-labelledby="sobre">
    <div class="wrap g faixa__in">
      <h1 id="sobre" class="t-titulo t-titulo--22 esc-pag__h1">Sobre o escritório</h1>
      <p class="t-lede esc-pag__lede">{foco}</p>
    </div>
  </section>

  <section class="wrap g secao" aria-label="O escritório">
    <div class="texto texto--2">
      {institucional.map((p) => <p>{p}</p>)}
    </div>
  </section>

  <section class="wrap" aria-labelledby="arquitetos">
    <div class="rotulo-secao"><h2 id="arquitetos" class="t-rotulo">Arquitetos</h2></div>
    <ul class="arquitetos">
      {arquitetos.map((a) => (
        <li>
          <h3 class="t-titulo t-titulo--13">{a.nome}</h3>
          <p class="t-meta">{a.formacao}, {a.ano}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="wrap secao" aria-labelledby="servicos">
    <div class="rotulo-secao"><h2 id="servicos" class="t-rotulo">Serviços</h2></div>
    <div class="servicos">
      <div>
        <h3 class="t-titulo t-titulo--13">Projeto</h3>
        <p class="t-corpo">{servicos.projeto}</p>
      </div>
      <div>
        <h3 class="t-titulo t-titulo--13">Obra</h3>
        <p class="t-corpo">{servicos.obra}</p>
      </div>
    </div>
  </section>
</A>
