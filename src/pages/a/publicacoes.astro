---
import A from '../../layouts/A.astro';
import Figura from '../../components/a/Figura.astro';
import { foto } from '../../lib/fotos';
import { pasta, publicacoes } from '../../data/publicacoes';
import { meta } from '../../components/a/site';

const descricao = meta(publicacoes.map((v) => `${v.veiculo} — ${v.descricao}`));
const idDe = (s: string) => s.toLowerCase().normalize('NFD').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
---
<A titulo="Publicações" descricao={descricao}>
  <section class="wrap pag__cab pag__cab--so-titulo">
    <div class="rotulo-secao">
      <h1 class="t-rotulo">Publicações</h1>
    </div>
  </section>

  {publicacoes.map((v) => (
    <section class="wrap veiculo" aria-labelledby={idDe(v.veiculo)}>
      <div class="rotulo-secao">
        <h2 id={idDe(v.veiculo)} class="t-rotulo">{v.veiculo}</h2>
        <span class="t-meta">{v.descricao}</span>
      </div>
      <div class="recortes">
        {v.recortes.map((r) => (
          <Figura
            img={foto(pasta, r.arquivo)}
            legenda={meta([r.titulo, r.ano])}
            proporcao="doc-45"
            sizes="(min-width: 1080px) 400px, (min-width: 720px) 46vw, 100vw"
            widths={[480, 800, 1200]}
          />
        ))}
      </div>
    </section>
  ))}
</A>
