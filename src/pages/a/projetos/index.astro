---
import { getCollection } from 'astro:content';
import A from '../../../layouts/A.astro';
import IndiceProjetos from '../../../components/a/IndiceProjetos.astro';
import { meta } from '../../../components/a/site';

const projetos = (await getCollection('projetos')).sort((a, b) => a.data.numero.localeCompare(b.data.numero));
const descricao = meta(projetos.map((p) => p.data.titulo));
---
<A titulo="Projetos" descricao={descricao}>
  <section class="wrap pag__cab">
    <div class="rotulo-secao">
      <h1 class="t-rotulo">Projetos</h1>
    </div>
    <IndiceProjetos projetos={projetos} nivel="h2" />
  </section>
  <div class="secao" aria-hidden="true"></div>
</A>
