---
import { getCollection } from 'astro:content';
import A from '../../layouts/A.astro';
import Figura from '../../components/a/Figura.astro';
import IndiceProjetos from '../../components/a/IndiceProjetos.astro';
import { foto } from '../../lib/fotos';
import { arquitetos, foco, posicao, servicos } from '../../data/escritorio';
import { href } from '../../components/a/site';

const projetos = (await getCollection('projetos')).sort((a, b) => a.data.numero.localeCompare(b.data.numero));
const abertura = foto('home', '003_8e604096.jpg');
---
<A descricao={posicao}>
  <section class="wrap g abertura" aria-label="Abertura">
    <div class="abertura__foto">
      <a href={href('projetos/louveira-1')}>
        <Figura
          img={abertura}
          legenda="Edifício Louveira 1 — Artigas, 1946"
          proporcao="5:4"
          sizes="(min-width: 1440px) 840px, (min-width: 1080px) 58vw, 100vw"
          eager
        />
      </a>
    </div>
    <h1 class="abertura__frase t-frase">{posicao}</h1>
  </section>

  <section class="wrap secao--g" aria-labelledby="projetos">
    <div class="rotulo-secao">
      <h2 id="projetos" class="t-rotulo"><a href={href('projetos')}>Projetos</a></h2>
    </div>
    <IndiceProjetos projetos={projetos} nivel="h3" />
  </section>

  <section class="wrap fio secao g" aria-labelledby="escritorio">
    <h2 id="escritorio" class="t-rotulo esc__rotulo"><a href={href('escritorio')}>Escritório</a></h2>
    <div class="esc__tx">
      <p class="t-lede">{foco}</p>
      <ul class="esc__nomes">
        {arquitetos.map((a) => (
          <li>
            <span class="t-titulo t-titulo--13">{a.nome}</span>
            <small>{a.formacao}, {a.ano}</small>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="faixa" aria-labelledby="servicos">
    <div class="wrap g faixa__in">
      <h2 id="servicos" class="t-rotulo faixa__rotulo">Serviços</h2>
      <ul class="faixa__lista">
        {servicos.lista.map((s) => <li>{s}</li>)}
      </ul>
    </div>
  </section>
</A>
