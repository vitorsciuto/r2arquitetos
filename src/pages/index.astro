---
import { Picture } from 'astro:assets';
import { getCollection } from 'astro:content';
import Layout from '../layouts/Base.astro';
import IndiceProjetos from '../components/IndiceProjetos.astro';
import Figura from '../components/Figura.astro';
import Ficha from '../components/Ficha.astro';
import { foto } from '../lib/fotos';
import { arquitetos, foco, nome, posicao } from '../data/escritorio';
import { href, meta } from '../lib/config';

const projetos = (await getCollection('projetos')).sort((a, b) => a.data.numero.localeCompare(b.data.numero));
const louveira = projetos.find((p) => p.data.slug === 'louveira-1')!;
const d = louveira.data;

// Em destaque — frases do escritório (texto do Louveira 1), com cortes.
const destaqueP1 = 'Projetado em 1946 por um dos mais renomados arquitetos brasileiros — João Batista Vilanova Artigas —, o Edifício Louveira é um dos marcos da moderna arquitetura de edifícios residenciais de São Paulo.';
const destaqueP2 = 'Os principais elementos originais do apartamento, como pastilhas, tacos de peroba e jardim de inverno, haviam sido retirados em intervenções anteriores. A proposta do r2arquitetos foi restabelecer esses elementos de acordo com o novo programa.';
---
<Layout
  titulo={nome}
  descricao={posicao}
>
  <div slot="abertura">
    <div class="wrap">
      <h1 class="sr-only">r2 arquitetos — arquitetura · urbanismo</h1>
      <p class="lede abertura-frase">{posicao}</p>
    </div>
    <figure class="hero">
      <Picture
        src={foto('capas-projetos', '006_cff1282f.jpg')}
        widths={[900, 1400, 1920, 2400]}
        sizes="100vw"
        formats={['avif', 'webp']}
        alt="Fachada do Edifício Lausanne, de Franz Heep: venezianas vinho, verdes e cinza"
        loading="eager"
        fetchpriority="high"
        decoding="sync"
      />
      <figcaption class="wrap"><span class="rotulo">Edifício Lausanne</span>Franz Heep, 1953–1958 · Higienópolis</figcaption>
    </figure>
  </div>

  <IndiceProjetos projetos={projetos} />

  <section class="secao" aria-labelledby="destaque-titulo" style={`--cor:${d.cor}`}>
    <div class="secao-cab rotulo">
      <span>Em destaque</span>
    </div>
    <div class="g">
      <div>
        <p class="rotulo">{d.numero}&nbsp;· {d.local}</p>
        <h2 id="destaque-titulo" class="titulo" style="margin-top: 14px"><a class="link" href={href(`projetos/${d.slug}/`)}>{d.titulo}</a></h2>
        <Ficha itens={[d.original, d.tombamento, `${d.intervencao}, ${d.anos}`]} class="mt10" />
        <div class="leitura-20" style="margin-top: 28px">
          <p>{destaqueP1}</p>
          <p>{destaqueP2}</p>
        </div>
        <div style="margin-top: 40px; max-width: 420px">
          <Figura
            img={foto('02-louveira-1', '001_bf69186d.png')}
            legenda="Anúncio da Imobiliária Itaoca para o Condomínio Louveira, “2 apartamentos por andar” — sem data."
            doc
            sizes="(max-width: 719px) 100vw, 420px"
            larguras={[480, 699]}
          />
        </div>
      </div>
      <Figura
        img={foto('02-louveira-1', '005_81f5fe68.jpg')}
        legenda="Sala com a caixilharia recuperada e os tacos de peroba, aberta para as copas das árvores"
        rotulo="Edifício Louveira 1"
        ratio="4:5"
        posicao="50% 35%"
        sizes="(max-width: 719px) 100vw, (max-width: 1079px) 40vw, 470px"
        larguras={[480, 800, 1200]}
      />
    </div>
  </section>

  <section class="secao" aria-labelledby="escritorio-titulo">
    <div class="secao-cab rotulo" style="--cor: var(--tinta)">
      <h2 id="escritorio-titulo" class="rotulo"><a href={href('escritorio/')}>Escritório</a></h2>
      <span>{meta(arquitetos.map((a) => a.nome))}</span>
    </div>
    <div class="g">
      <p class="leitura-20">{foco}</p>
      <dl class="t16">
        {arquitetos.map((a, i) => (
          <div style={i > 0 ? 'margin-top: 18px' : undefined}>
            <dt class="rotulo">{a.nome}</dt>
            <dd>{a.formacao},&nbsp;{a.ano}.</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>
</Layout>
