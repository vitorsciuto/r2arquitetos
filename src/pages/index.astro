---
import { Picture } from 'astro:assets';
import { getCollection } from 'astro:content';
import Layout from '../layouts/Base.astro';
import IndiceProjetos from '../components/IndiceProjetos.astro';
import Figura from '../components/Figura.astro';
import Ficha from '../components/Ficha.astro';
import { curadoria, foto } from '../lib/fotos';
import { nome, nomeCompleto, posicao, servicos, sobre } from '../data/escritorio';
import { credito, href, inseparavel, larguras, ordenarObras, SEP } from '../lib/config';

const projetos = ordenarObras(await getCollection('projetos'));

// Abertura: a obra mais recente, na foto de abertura da página dela, sangrando até a largura do original
// (régua §7: nunca acima de 100%). Hoje, a Cozinha Tremembé (022, a cozinha vista pela treliça, 2400 px).
const recente = projetos[0].data;
const heroAbertura = curadoria(recente.pasta).hero;
const imgAbertura = foto(recente.pasta, heroAbertura.arquivo);
const creditoAbertura = credito(recente.pasta, heroAbertura.arquivo);

// Escritório: foto da fachada do Edifício Louveira (home/003, 2000 px)
const fotoEscritorio = foto('home', '003_8e604096.jpg');
---
<Layout
  titulo={nome}
  descricao={posicao}
>
  <div slot="abertura">
    <div class="wrap">
      <h1 class="sr-only">{nomeCompleto}</h1>
      {/* frase do escritório (servicos.diferencial, texto do Wix), curta como a abertura do Cedo */}
      <p class="frase-abertura">{inseparavel(servicos.diferencial).replace(/-/g, '‑')}</p>
    </div>
    <figure class="sangra abertura-foto" style={`--largura-original:${imgAbertura.width}px`}>
      <Picture
        src={imgAbertura}
        widths={larguras(imgAbertura, [900, 1400, 2000])}
        sizes="(max-width: 719px) 170vw, (max-width: 1079px) 130vw, 100vw"
        formats={['avif', 'webp']}
        alt={heroAbertura.legenda}
        loading="eager"
        fetchpriority="high"
        decoding="sync"
      />
      <figcaption class="wrap">
        <a class="obra-ficha" href={href(`projetos/${recente.slug}/`)} style={`--cor:${recente.cor}`}>
          <span class="rotulo">{recente.titulo}</span>
          <Ficha itens={[recente.original, recente.tombamento, recente.intervencao, recente.anos]} />
          {creditoAbertura && <span class="credito">foto: {creditoAbertura}</span>}
        </a>
      </figcaption>
    </figure>
  </div>

  <IndiceProjetos projetos={projetos} />

  <section class="secao sobre-home" aria-labelledby="escritorio-titulo">
    <div class="secao-cab rotulo">
      <h2 id="escritorio-titulo" class="rotulo"><a href={href('escritorio/')}>Escritório</a></h2>
    </div>
    <div class="g">
      <div>
        <p class="lede">{inseparavel(posicao)}</p>
        <p class="leitura-19" style="margin-top: 32px">{inseparavel(sobre[0])}</p>
        <p class="t14" style="margin-top: 32px"><a class="link" href={href('escritorio/')}>Escritório{SEP}Rita Lo Sciuto e Rubens Reis</a></p>
      </div>
      <Figura
        img={fotoEscritorio}
        legenda="Fachada do Edifício Louveira: venezianas amarelas e painéis vermelhos entre as árvores"
        ratio="4:5"
        sizes="(max-width: 719px) 100vw, (max-width: 1079px) 40vw, 470px"
        larguras={[480, 800, 1200]}
      />
    </div>
  </section>
</Layout>
