---
import Layout from '../layouts/Base.astro';
import { arquitetos, foco, servicos, sobre } from '../data/escritorio';
import { inseparavel } from '../lib/config';

const paragrafos = sobre.filter((p) => p !== foco);
---
<Layout
  titulo="Escritório"
  descricao={foco}
  ativo="escritorio"
  og={{ src: '/r2-simbolo.png', largura: 512, altura: 512, alt: 'Símbolo do r2 arquitetos: monograma r2 branco sobre quadrado cinza' }}
  trilha={[{ nome: 'Escritório', caminho: '/escritorio' }]}
>
  <h1 class="titulo" style="padding: 72px 0 48px">Escritório</h1>

  <div class="g">
    <div>
      <p class="leitura-19">{inseparavel(foco)}</p>
      <div class="leitura" style="margin-top: 40px">
        {paragrafos.map((p) => <p>{inseparavel(p)}</p>)}
      </div>
    </div>

    <div>
      <div class="secao-cab rotulo"><span>Arquitetos</span></div>
      <dl class="t14" style="margin-top: 20px">
        {arquitetos.map((a, i) => (
          <div style={i > 0 ? 'margin-top: 18px' : undefined}>
            <dt class="rotulo">{a.nome}</dt>
            <dd>{a.formacao}</dd>
          </div>
        ))}
      </dl>

      <div class="secao-cab rotulo" style="margin-top: 56px"><span>Serviços</span></div>
      <div class="t14" style="margin-top: 20px">
        {servicos.lista.map((s) => <p>{s}</p>)}
      </div>
      <p class="t14" style="margin-top: 24px">{servicos.diferencial}</p>
    </div>
  </div>
</Layout>
