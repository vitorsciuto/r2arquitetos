---
import Layout from '../layouts/Base.astro';
import Contato from '../components/Contato.astro';
import { contato } from '../data/escritorio';
---
<Layout
  titulo="Contato"
  descricao={`r2 arquitetos — ${contato.enderecoFormal}. ${contato.telefone} · ${contato.email}`}
  ativo="contato"
  trilha={[{ nome: 'Contato', caminho: '/contato' }]}
>
  <h1 class="titulo" style="padding: 72px 0 48px">Contato</h1>
  <div class="g">
    <Contato grande mapa />
  </div>
</Layout>
