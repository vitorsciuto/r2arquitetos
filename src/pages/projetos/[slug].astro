---
import { Picture } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Base.astro';
import Figura from '../../components/Figura.astro';
import Ficha from '../../components/Ficha.astro';
import Figuras, { type Item } from '../../components/Figuras.astro';
import DiarioObra from '../../components/DiarioObra.astro';
import { curadoria, foto, fotosDoCapitulo, type FotoCurada } from '../../lib/fotos';
import { credito, creditosPasta, heroB, inseparavel, larguras, ordenarObras, posicao, quadros, SEP, tituloCapitulo } from '../../lib/config';
import { recorteOg } from '../../lib/og';

export async function getStaticPaths() {
  const projetos = ordenarObras(await getCollection('projetos'));
  return projetos.map((p) => ({ params: { slug: p.data.slug }, props: { entry: p } }));
}
interface Props { entry: CollectionEntry<'projetos'> }
const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const cur = curadoria(d.pasta);

/** Aspas duplas curvas nas legendas da curadoria (retas e simples curvas viram “ ”); legendas corrigidas pela spec. */
const legendasFixas: Record<string, string> = {
  '02-louveira-1/001_bf69186d.png': 'Anúncio da Imobiliária Itaoca para o Condomínio Louveira, “2 apartamentos por andar”, sem data',
};
const legenda = (f: FotoCurada) =>
  legendasFixas[`${d.pasta}/${f.arquivo}`] ?? f.legenda.replace(/'([^']+)'/g, '“$1”').replace(/‘([^’]+)’/g, '“$1”');
const ehDoc = new Set(cur.documentos.map((x) => x.arquivo));
const item = (f: FotoCurada): Item => ({ img: foto(d.pasta, f.arquivo), legenda: legenda(f), credito: creditosPasta[d.pasta] ? undefined : credito(d.pasta, f.arquivo), orientacao: f.orientacao, doc: ehDoc.has(f.arquivo), posicao: posicao(d.pasta, f.arquivo) });

// hero: o da curadoria, salvo decisão de edição da Opção B (heroB)
const heroArq = heroB[d.pasta];
const hero: FotoCurada = (heroArq && [...cur.destaques, cur.capa, cur.hero].find((f) => f.arquivo === heroArq)) || cur.hero;
const heroRetrato = hero.orientacao === 'retrato';
const multi = cur.capitulos.length > 1;
const usados = new Set<string>([hero.arquivo]);

// margem (5 colunas ao lado do texto): documentos; sem documentos, um destaque retrato
const margem: Item[] = [];
const docsMargem = multi ? cur.documentos.slice(0, 2) : cur.documentos;
for (const doc of docsMargem) { margem.push(item(doc)); usados.add(doc.arquivo); }
if (margem.length === 0 && !heroRetrato) {
  const p = cur.destaques.find((x) => x.orientacao === 'retrato' && !usados.has(x.arquivo));
  if (p) { margem.push(item(p)); usados.add(p.arquivo); }
}

// destaques restantes (projetos sem capítulos múltiplos)
const destaquesCurados = multi ? [] : cur.destaques.filter((x) => !usados.has(x.arquivo));
destaquesCurados.forEach((x) => usados.add(x.arquivo));
const destaques: Item[] = destaquesCurados.map(item);

// capítulos (Praça Roosevelt): fotos e documentos por faixa; "Fase de obras" vira diário
const capitulos = multi
  ? cur.capitulos
      .filter((c) => !/obras/i.test(c.titulo))
      .map((c) => {
        const fotos = fotosDoCapitulo(d.pasta, cur, c).filter((f) => f.legenda && !usados.has(f.arquivo));
        const itens = fotos.map(item);
        return { titulo: tituloCapitulo(c.titulo), itens, docs: itens.every((i) => i.doc) };
      })
      .filter((c) => c.itens.length > 0)
  : [];
const tituloObra = tituloCapitulo(cur.capitulos.find((c) => /obras/i.test(c.titulo))?.titulo ?? 'Fase de obras');

const heroLegenda = legenda(hero);
const heroImg = foto(d.pasta, hero.arquivo);
// obra fotografada por um só fotógrafo: crédito uma vez, na ficha; nas legendas ele não se repete
const creditoObra = creditosPasta[d.pasta];
const heroCredito = creditoObra ? undefined : credito(d.pasta, hero.arquivo);
const heroPos = posicao(d.pasta, hero.arquivo);
// foto de compartilhamento: o mesmo quadro que representa a obra nos índices, recortado na horizontal
const q = quadros[d.numero];
const quadro = foto(q.pasta, q.arquivo);
const r = recorteOg(quadro.width, quadro.height, q.posicao);
const og = { src: `/og/${d.slug}.jpg`, largura: r.saidaL, altura: r.saidaA, alt: q.legenda };
---
<Layout
  titulo={d.titulo}
  descricao={d.resumo}
  og={og}
  cor={d.cor}
  ativo="projetos"
  trilha={[
    { nome: 'Projetos', caminho: '/projetos' },
    { nome: d.titulo, caminho: `/projetos/${Astro.params.slug}` },
  ]}
>
  {/* abertura: a foto sangra até a largura do original (régua §7), como no Cedo; retrato vai para a margem */}
  {!heroRetrato && (
    <figure slot="abertura" class="sangra proj-hero" style={`--largura-original:${heroImg.width}px`}>
      <Picture
        src={heroImg}
        widths={larguras(heroImg, [900, 1400, 2000])}
        sizes="(max-width: 719px) 170vw, (max-width: 1079px) 130vw, 100vw"
        formats={['avif', 'webp']}
        alt={heroLegenda}
        loading="eager"
        fetchpriority="high"
        decoding="sync"
        style={heroPos ? `object-position:${heroPos}` : undefined}
      />
      <figcaption class="wrap t13">{heroLegenda}{heroCredito && `${SEP}foto: ${heroCredito}`}</figcaption>
    </figure>
  )}

  <article>
    <header class="proj-intro">
      <div>
        <p class="rotulo">{inseparavel(d.local)}</p>
        <h1 class="titulo-grande">{d.titulo}</h1>
        {d.subtitulo && <p class="subtitulo">{d.subtitulo}</p>}
      </div>
      <div class="proj-cab">
        <Ficha itens={[d.original, d.tombamento, d.intervencao, d.anos]} />
        {creditoObra && <p class="ficha">foto: {creditoObra}</p>}
      </div>
    </header>

    <div class="proj-corpo">
      <aside class="margem" aria-label="Figuras">
        {heroRetrato && (
          <Figura img={heroImg} legenda={heroLegenda} credito={heroCredito} ratio="4:5" posicao={heroPos} eager sizes="(max-width: 719px) 100vw, (max-width: 1079px) 40vw, 470px" />
        )}
        {margem.map((m) => (
          <Figura img={m.img} legenda={m.legenda} credito={m.credito} ratio={m.doc ? 'nativa' : m.orientacao === 'retrato' ? '4:5' : '5:4'} doc={m.doc} posicao={m.posicao} sizes="(max-width: 719px) 100vw, (max-width: 1079px) 40vw, 470px" larguras={[480, 800, 1200]} />
        ))}
      </aside>
      <div class="leitura">
        <Content />
      </div>
    </div>

    {destaques.length > 0 && (
      <section class="secao galeria" aria-label={`Fotos: ${d.titulo}`}>
        <Figuras itens={destaques} />
      </section>
    )}

    {capitulos.map((c) => (
      <section class="secao" aria-label={c.titulo}>
        <div class="secao-cab rotulo">
          <h2 class="rotulo">{c.titulo}</h2>
        </div>
        <Figuras itens={c.itens} docs={c.docs} />
      </section>
    ))}

    <DiarioObra pasta={d.pasta} fotos={cur.obra} titulo={tituloObra} />

  </article>
</Layout>
