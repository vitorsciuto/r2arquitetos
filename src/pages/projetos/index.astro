---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Base.astro';
import CartaoObra from '../../components/CartaoObra.astro';
import { nomeIndice, ordenarObras } from '../../lib/config';

const projetos = ordenarObras(await getCollection('projetos'));
// descrição tirada da coleção: acompanha a entrada de novas obras
const nomes = projetos.map((p) => nomeIndice(p.data));
const descricao = `Projetos do r2 arquitetos: ${nomes.slice(0, -1).join(', ')} e ${nomes[nomes.length - 1]}.`;
---
<Layout
  titulo="Projetos"
  descricao={descricao}
  ativo="projetos"
  trilha={[{ nome: 'Projetos', caminho: '/projetos' }]}
>
  <h1 class="titulo" style="padding: 72px 0 56px">Projetos</h1>

  <ol class="grade3">
    {projetos.map((p, i) => (
      <li>
        <CartaoObra p={p} eager={i < 3} proporcao={4 / 5} sizes="(max-width: 719px) 100vw, (max-width: 1079px) 45vw, 372px" />
      </li>
    ))}
  </ol>
</Layout>
