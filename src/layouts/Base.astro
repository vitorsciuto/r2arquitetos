---
import '../styles/base.css';
import '../styles/site.css';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import logoRaw from '../assets/logo-r2.svg?raw';
import Cabecalho from '../components/Cabecalho.astro';
import Rodape from '../components/Rodape.astro';
import { nome } from '../data/escritorio';
import { escritorioJsonLd, trilhaJsonLd } from '../lib/estruturado';
import { foto } from '../lib/fotos';

interface Props {
  titulo: string;                 // título da página (sem o nome do escritório)
  descricao: string;
  ogImagem?: ImageMetadata;       // capa para og:image (default: fachada do Louveira)
  cor?: string;                   // cor da obra (páginas de projeto)
  ativo?: string;                 // item do menu ativo: 'projetos' | 'escritorio' | 'publicacoes' | 'contato'
  /** Trilha para o JSON-LD, sem a home (ela é acrescentada aqui). Omitir na home. */
  trilha?: { nome: string; caminho: string }[];
}
const { titulo, descricao, ogImagem, cor, ativo, trilha } = Astro.props;
const tituloCompleto = titulo === nome ? `${nome} — arquitetura · urbanismo` : `${titulo} — ${nome}`;
const og = await getImage({ src: ogImagem ?? foto('capas-projetos', '003_0d0a1121.jpg'), width: 1200, format: 'jpg' });
const ogUrl = Astro.site ? new URL(og.src, Astro.site).href : og.src;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.pathname;

// favicon: a marca do escritório embutida como data-URI
const favicon =
  'data:image/svg+xml,' +
  encodeURIComponent(logoRaw.replace('currentColor', '#66574A').replace('var(--logo-fg, #fff)', '#F5F4F1'));

// dados estruturados: o escritório em toda página; a trilha só nas internas
const jsonLd: Record<string, unknown>[] = [escritorioJsonLd(ogUrl)];
if (trilha?.length) jsonLd.push(trilhaJsonLd([{ nome, caminho: '/' }, ...trilha]));
---
<!doctype html>
<html lang="pt-BR" style={cor ? `--cor:${cor}` : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descricao} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={nome} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descricao} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:locale" content="pt_BR" />
    <meta name="theme-color" content="#E4E1DB" />
    <link rel="icon" href={favicon} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {jsonLd.map((bloco) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(bloco)} />
    ))}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip" href="#conteudo">Ir para o conteúdo</a>
    <Cabecalho ativo={ativo} />
    {/* abertura: conteúdo que precisa sangrar além da mancha (a foto da home) */}
    <slot name="abertura" />
    <main id="conteudo" class="wrap">
      <slot />
    </main>
    <Rodape />
  </body>
</html>
