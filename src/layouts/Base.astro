---
import '../styles/base.css';
import '../styles/site.css';
import Cabecalho from '../components/Cabecalho.astro';
import Rodape from '../components/Rodape.astro';
import { nome, nomeCompleto } from '../data/escritorio';
import { escritorioJsonLd, trilhaJsonLd } from '../lib/estruturado';
import { LEGENDA_LAUSANNE, SEP } from '../lib/config';

interface Props {
  titulo: string;                 // título da página (sem o nome do escritório)
  descricao: string;
  /** Foto de compartilhamento (og:image), horizontal. Padrão: fachada do Lausanne (public/og-lausanne.jpg). */
  og?: { src: string; largura: number; altura: number; alt: string };
  cor?: string;                   // cor da obra (páginas de projeto): fio no topo da ficha
  ativo?: string;                 // item do menu ativo: 'projetos' | 'escritorio' | 'publicacoes' | 'contato'
  /** Trilha para o JSON-LD, sem a home (ela é acrescentada aqui). Omitir na home. */
  trilha?: { nome: string; caminho: string }[];
  /** Página fora do índice (404): sem canonical e sem dados estruturados. */
  semIndice?: boolean;
}
const { titulo, descricao, og, cor, ativo, trilha, semIndice = false } = Astro.props;
const tituloCompleto = titulo === nome ? nomeCompleto : `${titulo}${SEP}${nome}`;

// Foto de compartilhamento, sempre horizontal. A padrão (public/og-lausanne.jpg, 1200×630) é um
// recorte da fachada do Edifício Lausanne da abertura da home, feito do original do acervo
// (fotos-wix/capas-projetos/006_cff1282f.jpg). As dos projetos saem de pages/og/[slug].jpg.ts.
const OG_PADRAO = '/og-lausanne.jpg';
const foto = og ?? { src: OG_PADRAO, largura: 1200, altura: 630, alt: LEGENDA_LAUSANNE };
const absoluta = (u: string) => (Astro.site ? new URL(u, Astro.site).href : u);
const ogUrl = absoluta(foto.src);
// foto horizontal: cartão grande; imagem quadrada (o símbolo, na página de contato): cartão simples
const cartao = foto.largura / foto.altura >= 1.5 ? 'summary_large_image' : 'summary';
const canonical = absoluta(Astro.url.pathname);

// dados estruturados: o escritório em toda página; a trilha só nas internas
const jsonLd: Record<string, unknown>[] = semIndice ? [] : [escritorioJsonLd()];
if (!semIndice && trilha?.length) jsonLd.push(trilhaJsonLd([{ nome, caminho: '/' }, ...trilha]));
---
<!doctype html>
<html lang="pt-BR" style={cor ? `--cor:${cor}` : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descricao} />
    {semIndice ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={nome} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descricao} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content={String(foto.largura)} />
    <meta property="og:image:height" content={String(foto.altura)} />
    <meta property="og:image:alt" content={foto.alt} />
    <meta property="og:locale" content="pt_BR" />
    <meta name="twitter:card" content={cartao} />
    <meta name="theme-color" content="#F2F2F2" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {jsonLd.map((bloco) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(bloco)} />
    ))}
    <link rel="preload" href="/fonts/WorkSans-Variable.ttf" as="font" type="font/ttf" crossorigin />
  </head>
  <body>
    <a class="skip" href="#conteudo">Ir para o conteúdo</a>
    <Cabecalho ativo={ativo} />
    {/* abertura: conteúdo que precisa sangrar além da mancha (a foto da home) */}
    <slot name="abertura" />
    <main id="conteudo" class="wrap">
      <slot />
    </main>
    <Rodape />
  </body>
</html>
