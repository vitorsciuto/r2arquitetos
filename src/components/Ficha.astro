---
/** Ficha técnica em uma linha: itens separados por " · "; quebra só nos separadores (no mobile cada item desce inteiro e só quebra por dentro se não couber na linha). */
interface Props { itens: (string | undefined | null)[]; class?: string }
const { itens, class: cls } = Astro.props;
const lista = itens.filter((t): t is string => !!t && t.trim() !== '');
---
<p class:list={['ficha', cls]}>
  {lista.map((t, i) => (
    <>{i > 0 && <span class="sep">&nbsp;·</span>}{i > 0 && ' '}<span class="item">{t}</span></>
  ))}
</p>
<style>
  .item { white-space: nowrap; }
  @media (max-width: 719px) { .item { display: inline-block; white-space: normal; } }
</style>
