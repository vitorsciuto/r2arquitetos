---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { fatorRecorte, larguras, SEP, sizesRecorte } from '../lib/config';

/**
 * Foto tratada como figura: recorte 5:4 / 4:5 via CSS, documentos em proporção nativa.
 * Sempre nas cores originais (régua §7). Legenda com rótulo opcional (número da figura)
 * e crédito quando houver ("foto: Nome", régua §6).
 * No recorte, `sizes` é multiplicado pelo fator de recorte: uma foto mais larga que a caixa
 * aparece mais larga que ela, e o arquivo carregado nunca pode ser ampliado (régua §7).
 */
interface Props {
  img: ImageMetadata;
  legenda: string;
  credito?: string;       // autor da foto
  rotulo?: string;
  ratio?: '5:4' | '4:5' | '1:1' | 'nativa';
  doc?: boolean;          // documento de época: proporção nativa, sem recorte
  sizes?: string;
  eager?: boolean;
  posicao?: string;       // object-position
  semLegenda?: boolean;   // legenda só no alt
  class?: string;
  id?: string;
  larguras?: number[];
}
const {
  img, legenda, credito, rotulo, ratio = 'nativa', doc = false,
  sizes = '(max-width: 719px) 100vw, (max-width: 1079px) 60vw, 660px',
  eager = false, posicao, semLegenda = false, class: cls, id, larguras: base,
} = Astro.props;
const r = ratio === '5:4' ? 'r54' : ratio === '4:5' ? 'r45' : ratio === '1:1' ? 'r11' : '';
const caixa = ratio === '5:4' ? 5 / 4 : ratio === '4:5' ? 4 / 5 : ratio === '1:1' ? 1 : null;
const sizesFinal = caixa ? sizesRecorte(sizes, fatorRecorte(img, caixa)) : sizes;
const widths = larguras(img, base);
---
<figure class:list={['fig', r, { doc, nativa: ratio === 'nativa' }, cls]} id={id} style={ratio === 'nativa' ? `--largura-nativa:${img.width}px` : undefined}>
  <Picture
    src={img}
    widths={widths}
    formats={['avif', 'webp']}
    sizes={sizesFinal}
    alt={legenda}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : undefined}
    decoding={eager ? 'sync' : 'async'}
    style={posicao ? `object-position:${posicao}` : undefined}
  />
  {!semLegenda && (
    <figcaption>
      {rotulo && <span class="rotulo">{rotulo}</span>}{legenda}{credito && <span class="credito">{SEP}foto: {credito}</span>}
    </figcaption>
  )}
</figure>
