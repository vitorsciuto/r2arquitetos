---
/** Índice dos 6 projetos — grade 3 + 3, foto 5:4, título em caixa-alta taupe 13 px, metadados 13 px preto. */
import type { CollectionEntry } from 'astro:content';
import Figura from './Figura.astro';
import { foto } from '../../lib/fotos';
import { capas, href, meta, nomeIndice } from './site';

interface Props { projetos: CollectionEntry<'projetos'>[]; nivel?: 'h2' | 'h3' }
const { projetos, nivel = 'h3' } = Astro.props;
const Titulo = nivel;
---
<ul class="indice">
  {projetos.map((p) => {
    const c = capas[p.data.slug];
    if (!c) throw new Error(`Capa não definida para ${p.data.slug}`);
    const img = foto(c.pasta, c.arquivo);
    return (
      <li class="indice__item">
        <a class="indice__link" href={href(`projetos/${p.data.slug}`)}>
          <Figura
            img={img}
            legenda={c.legenda}
            proporcao="5:4"
            posicao={c.posicao}
            sizes="(min-width: 1080px) 400px, (min-width: 720px) 46vw, 100vw"
            semLegenda
          />
          <Titulo class="t-titulo t-titulo--13">{nomeIndice(p)}</Titulo>
          <p class="t-meta">{meta([p.data.cidade === 'São Paulo' ? p.data.bairro : p.data.cidade, p.data.original || p.data.intervencao, p.data.anos])}</p>
        </a>
      </li>
    );
  })}
</ul>
