---
/**
 * Figura — <Picture> + legenda. Recortes 5:4 / 4:5 / 4:3 por CSS; documentos em proporção nativa,
 * nunca maiores que a largura em pixels do original.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  img: ImageMetadata;
  legenda: string;
  /** 5:4 / 4:5 / 4:3 = recorte por CSS · nativa = proporção do arquivo · doc-54 / doc-45 = documento inteiro sobre um passe-partout 5:4 ou 4:5, nunca ampliado */
  proporcao?: '5:4' | '4:5' | '4:3' | 'nativa' | 'doc-54' | 'doc-45';
  posicao?: string;
  sizes: string;
  widths?: number[];
  eager?: boolean;
  semLegenda?: boolean;
  class?: string;
}
const {
  img, legenda, proporcao = '5:4', posicao, sizes,
  widths = [480, 800, 1200, 1600], eager = false, semLegenda = false, class: classe,
} = Astro.props;
const mod = { '5:4': 'fig--54', '4:5': 'fig--45', '4:3': 'fig--43', nativa: 'fig--nativa', 'doc-54': 'fig--doc fig--doc54', 'doc-45': 'fig--doc fig--doc45' }[proporcao];
const semAmpliar = proporcao === 'nativa' || proporcao.startsWith('doc');
const estiloFig = proporcao === 'nativa' ? `max-width:${img.width}px` : undefined;
const estiloImg = [posicao ? `object-position:${posicao}` : '', semAmpliar ? `max-width:min(100%,${img.width}px)` : ''].filter(Boolean).join(';') || undefined;
---
<figure class:list={['fig', mod, classe]} style={estiloFig}>
  <Picture
    src={img}
    widths={widths}
    formats={['avif', 'webp']}
    sizes={sizes}
    alt={legenda}
    loading={eager ? 'eager' : 'lazy'}
    decoding={eager ? 'sync' : 'async'}
    fetchpriority={eager ? 'high' : undefined}
    style={estiloImg}
  />
  {!semLegenda && legenda && <figcaption>{legenda}</figcaption>}
</figure>
