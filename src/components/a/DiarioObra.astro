---
/** Fase de obras — tira de miniaturas 4:3 (até 12) em uma linha rolável. */
import type { FotoCurada } from '../../lib/fotos';
import { foto } from '../../lib/fotos';
import Figura from './Figura.astro';
import { legenda } from './site';

interface Props { pasta: string; fotos: FotoCurada[] }
const { pasta, fotos } = Astro.props;
const lista = fotos.slice(0, 12);
---
<div class="tira" tabindex="0" aria-label="Fotos da obra (rolagem horizontal)">
  {lista.map((f) => (
    <Figura img={foto(pasta, f.arquivo)} legenda={legenda(pasta, f.arquivo, f.legenda)} proporcao="4:3" sizes="224px" widths={[240, 480]} />
  ))}
</div>
