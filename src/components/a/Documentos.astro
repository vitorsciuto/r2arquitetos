---
/** Documentos (anúncios, recortes, plantas, croquis, fotos históricas) em proporção nativa, com legenda. */
import type { FotoCurada } from '../../lib/fotos';
import { foto } from '../../lib/fotos';
import Figura from './Figura.astro';
import { legenda } from './site';

interface Props { pasta: string; docs: FotoCurada[] }
const { pasta, docs } = Astro.props;
const colunas = docs.length === 1 ? 1 : docs.length === 2 ? 2 : 3;
const sizes = colunas === 1
  ? '(min-width: 1080px) 780px, 100vw'
  : colunas === 2
    ? '(min-width: 1080px) 580px, (min-width: 720px) 46vw, 100vw'
    : '(min-width: 1080px) 400px, (min-width: 720px) 46vw, 100vw';
---
<div class:list={['documentos', `documentos--${colunas}`]}>
  {docs.map((d) => (
    <Figura img={foto(pasta, d.arquivo)} legenda={legenda(pasta, d.arquivo, d.legenda)} proporcao="doc-54" sizes={sizes} widths={[480, 800, 1200]} />
  ))}
</div>
