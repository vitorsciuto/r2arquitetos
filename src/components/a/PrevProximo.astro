---
import type { CollectionEntry } from 'astro:content';
import { href, nomeIndice } from './site';

interface Props { anterior: CollectionEntry<'projetos'>; proximo: CollectionEntry<'projetos'> }
const { anterior, proximo } = Astro.props;
---
<nav class="prevprox" aria-label="Projeto anterior e próximo">
  <a href={href(`projetos/${anterior.data.slug}`)} rel="prev">
    <span class="t-rotulo">Anterior</span>
    <span class="t-titulo t-titulo--13">{anterior.data.numero} {nomeIndice(anterior)}</span>
  </a>
  <a class="prevprox__prox" href={href(`projetos/${proximo.data.slug}`)} rel="next">
    <span class="t-rotulo">Próximo</span>
    <span class="t-titulo t-titulo--13">{proximo.data.numero} {nomeIndice(proximo)}</span>
  </a>
</nav>
