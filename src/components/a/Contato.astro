---
/** Bloco de contato estilo Una: minúsculas, linhas empilhadas, e-mail sublinhado. */
import { contato } from '../../data/escritorio';
import { fixarSep } from './site';

interface Props { grande?: boolean; class?: string }
const { grande = false, class: classe } = Astro.props;
---
<address class:list={['contato', { 'contato--grande': grande }, classe]}>
  <p>{fixarSep(contato.endereco[0])}<br />{fixarSep(contato.endereco[1])}</p>
  <p><a href={contato.telefoneHref}>{contato.telefone}</a></p>
  <p><a class="contato__email" href={`mailto:${contato.email}`}>{contato.email}</a></p>
</address>
