---
import Logo from '../../assets/logo-r2.svg';
import { menu, nome } from '../../data/escritorio';
import Contato from './Contato.astro';
import { href } from './site';

const atual = Astro.url.pathname;
const ativo = (h: string): 'page' | undefined => (atual.startsWith(href(h)) ? 'page' : undefined);
---
<footer class="rod">
  <div class="wrap g rod__in">
    <a class="rod__marca" href={href('')}>
      <Logo class="rod__logo" />
      <span class="t-rotulo rod__nome">{nome}</span>
    </a>
    <Contato class="rod__contato" />
    <nav class="rod__nav" aria-label="Rodapé">
      <ul>
        {menu.map((m) => (
          <li><a href={href(m.href)} aria-current={ativo(m.href)}>{m.rotulo}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</footer>
