---
import type { CollectionEntry } from 'astro:content';
import CartaoObra from './CartaoObra.astro';

/**
 * Índice das obras na home: o mesmo cartão e a mesma grade de /projetos (CartaoObra, três
 * colunas de fotos 4:5), da obra mais recente para a mais antiga. Sem JavaScript.
 */
interface Props { projetos: CollectionEntry<'projetos'>[] }
const { projetos } = Astro.props;
---
<section aria-labelledby="indice-titulo" class="indice">
  <h2 id="indice-titulo" class="sr-only">Projetos</h2>
  <ol class="grade3">
    {projetos.map((p, i) => (
      <li>
        <CartaoObra p={p} eager={i < 3} proporcao={4 / 5} sizes="(max-width: 719px) 100vw, (max-width: 1079px) 45vw, 372px" />
      </li>
    ))}
  </ol>
</section>
