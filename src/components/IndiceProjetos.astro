---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Figura from './Figura.astro';
import { foto } from '../lib/fotos';
import { href, material, meta, nomeIndice, quadros } from '../lib/config';

/**
 * Índice dos seis projetos (7 colunas) + quadro 4:5 (5 colunas) que troca com a linha ativa.
 * Sem JS a foto fixa é a do 02. Hover no desktop; no celular o primeiro toque seleciona, o segundo abre.
 */
interface Props { projetos: CollectionEntry<'projetos'>[]; ativo?: string }
const { projetos, ativo = '02' } = Astro.props;
---
<section class="g" data-indice aria-labelledby="indice-titulo">
  <h2 id="indice-titulo" class="sr-only">Projetos</h2>
  <ol class="idx-lista">
    {projetos.map((p) => (
      <li>
        <a
          class:list={['linha', { ativa: p.data.numero === ativo }]}
          href={href(`projetos/${p.data.slug}/`)}
          data-n={p.data.numero}
          style={`--cor:${p.data.cor}`}
        >
          <span class="num rotulo">{p.data.numero}</span>
          <span class="mat" aria-hidden="true"><Image src={material(p.data.numero)} width={80} height={80} alt="" loading="eager" /></span>
          <span class="nome">{nomeIndice(p.data)}</span>
          <span class="anos">{p.data.anos}</span>
          <span class="meta">{meta([p.data.original, p.data.bairro, p.data.tipo])}</span>
        </a>
      </li>
    ))}
  </ol>
  <div class="idx-foto">
    {projetos.map((p) => {
      const q = quadros[p.data.numero];
      return (
        <Figura
          class={p.data.numero === ativo ? 'ativa' : undefined}
          id={`quadro-${p.data.numero}`}
          img={foto(q.pasta, q.arquivo)}
          legenda={q.legenda}
          rotulo={`${p.data.numero} · ${nomeIndice(p.data)}`}
          ratio="4:5"
          posicao={q.posicao}
          eager={p.data.numero === ativo}
          sizes="(max-width: 719px) 100vw, (max-width: 1079px) 40vw, 470px"
          larguras={[480, 800, 1000]}
        />
      );
    })}
  </div>
</section>

<script is:inline>
  (function () {
    var idx = document.querySelector('[data-indice]');
    if (!idx) return;
    var linhas = idx.querySelectorAll('[data-n]');
    var figs = idx.querySelectorAll('.idx-foto > figure');
    var toque = window.matchMedia('(hover: none)').matches;
    function ativar(n) {
      linhas.forEach(function (l) { l.classList.toggle('ativa', l.dataset.n === n); });
      figs.forEach(function (f) { f.classList.toggle('ativa', f.id === 'quadro-' + n); });
    }
    linhas.forEach(function (l) {
      l.addEventListener('mouseenter', function () { ativar(l.dataset.n); });
      l.addEventListener('focus', function () { ativar(l.dataset.n); });
      l.addEventListener('click', function (e) {
        if (toque && !l.classList.contains('ativa')) {
          e.preventDefault();
          ativar(l.dataset.n);
          idx.querySelector('.idx-foto').scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
    });
  })();
</script>
