---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { foto } from '../lib/fotos';
import { href, meta, nomeIndice, quadros } from '../lib/config';

/**
 * Índice dos seis projetos: um cartão por obra, com foto, número, nome, anos e
 * a ficha curta. Um clique ou toque abre o projeto.
 *
 * Mesma experiência em qualquer tela, de propósito. Antes o desktop trocava a
 * foto no hover e o celular tinha outro comportamento — duas dinâmicas para o
 * mesmo conteúdo, e a do celular precisava de dois toques. Agora muda só o
 * número de colunas: duas no computador, uma no celular. Sem JavaScript.
 */
interface Props { projetos: CollectionEntry<'projetos'>[] }
const { projetos } = Astro.props;
---
<section aria-labelledby="indice-titulo">
  <h2 id="indice-titulo" class="sr-only">Projetos</h2>
  <ol class="idx-lista">
    {projetos.map((p, i) => (
      <li>
        <a
          class="linha"
          href={href(`projetos/${p.data.slug}/`)}
          style={`--cor:${p.data.cor}`}
        >
          <span class="foto" aria-hidden="true">
            <Image
              src={foto(quadros[p.data.numero].pasta, quadros[p.data.numero].arquivo)}
              widths={[420, 640, 900]}
              sizes="(max-width: 719px) 100vw, (max-width: 1079px) 46vw, 560px"
              alt=""
              loading={i < 2 ? 'eager' : 'lazy'}
              style={`object-position:${quadros[p.data.numero].posicao}`}
            />
          </span>
          <span class="num rotulo">{p.data.numero}</span>
          <span class="nome">{nomeIndice(p.data)}</span>
          <span class="anos">{p.data.anos}</span>
          <span class="meta">{meta([p.data.original, p.data.bairro, p.data.tipo])}</span>
        </a>
      </li>
    ))}
  </ol>
</section>

