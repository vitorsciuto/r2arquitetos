---
import type { CollectionEntry } from 'astro:content';
import { href } from '../lib/config';

interface Props { anterior: CollectionEntry<'projetos'>; proximo: CollectionEntry<'projetos'> }
const { anterior, proximo } = Astro.props;
---
<nav class="prox" aria-label="Projeto anterior e próximo">
  <a href={href(`projetos/${anterior.data.slug}/`)} rel="prev">
    <span class="rotulo">Anterior</span>
    <span class="nome" style="display:block">{anterior.data.titulo}</span>
  </a>
  <a class="dir" href={href(`projetos/${proximo.data.slug}/`)} rel="next">
    <span class="rotulo">Próximo</span>
    <span class="nome" style="display:block">{proximo.data.titulo}</span>
  </a>
</nav>
