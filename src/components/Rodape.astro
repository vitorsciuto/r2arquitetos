---
import Contato from './Contato.astro';
import { contato, menu, nome } from '../data/escritorio';
import { href } from '../lib/config';
const ano = new Date().getFullYear();
---
<footer class="wrap rod">
  <div class="g">
    <Contato />
    <div class="rod-dir rotulo">
      <nav aria-label="Rodapé">
        <ul>
          {menu.map((m) => <li><a href={href(m.href + '/')}>{m.rotulo}</a></li>)}
        </ul>
      </nav>
      <p class="rod-social">
        <a href={contato.instagram} rel="me noopener" target="_blank">Instagram {contato.instagramArroba}</a>
      </p>
      <p>© {ano} {nome}</p>
    </div>
  </div>
</footer>
